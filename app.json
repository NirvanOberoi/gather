{
  "expo": {
    "name": "Gather",
    "slug": "gather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.gather.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B2FC9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.gather.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6FB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#121218"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gather uses your photos so you can set a profile or group picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gather uses your approximate location only when you ask for nearby ideas. It is never shared with friends."
        }
      ]
    ],
    "scheme": "gather",
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
