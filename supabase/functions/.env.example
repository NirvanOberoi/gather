# Edge Function secrets (server-side only). Copy to supabase/functions/.env and run:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Required for Gather AI (group planner + private assistant)
ANTHROPIC_API_KEY=

# Optional: override the model / effort used by Gather AI
GATHER_AI_MODEL=claude-opus-5-5
GATHER_AI_EFFORT=medium

# Optional: enables real place search (Google Places API "New").
# Without it, Explore shows only clearly labelled sample data in demo mode, and the AI
# gives general activity ideas without naming specific businesses.
GOOGLE_MAPS_API_KEY=

# Daily AI request limits per user
AI_DAILY_LIMIT_FREE=15
AI_DAILY_LIMIT_PREMIUM=150
