# ---------------------------------------------------------------------------
# Gather – client configuration (bundled into the app; PUBLIC values only)
# ---------------------------------------------------------------------------
# Leave these blank to run Gather in demo mode only.
# Supabase "anon"/publishable key is designed to be public; access is enforced by RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side secrets – NEVER put these in an EXPO_PUBLIC_ variable.
# Set them as Supabase Edge Function secrets:
#   npx supabase secrets set --env-file supabase/functions/.env
# (see supabase/functions/.env.example)
# ---------------------------------------------------------------------------
